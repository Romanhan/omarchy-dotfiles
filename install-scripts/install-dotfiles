#!/bin/bash
# Stow this checkout into ~/.config. Run from anywhere; the repo is resolved
# from this script, not from a hardcoded ~/dotfiles path.
set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DOTFILES_DIR"

# stow is the only thing this script needs; omarchy pkg skips it when present.
omarchy pkg add stow

STOW_PACKAGES=(bash kitty hypr superfile omarchy vscode)

# The scaling shortcut replaces the monitors.lua symlink with a regular file.
# Fold its content back into the repo first so stow does not hit a conflict.
"$DOTFILES_DIR/install-scripts/sync-monitors"

for package in "${STOW_PACKAGES[@]}"; do
  if [ -d "$package" ]; then
    echo "Stowing $package..."
    # Plain stow is idempotent and, unlike --restow, never unlinks a correct
    # symlink first. Hyprland and the shell watch these paths and would see a
    # missing monitors.lua/shell file during the gap.
    stow "$package"
  else
    echo "Warning: $package not found, skipping"
  fi
done

# shell.json is excluded from stow. Seed the repo snapshot on a fresh machine,
# or when the live file is still Omarchy's untouched default.
live="$HOME/.config/omarchy/shell.json"
stock="/usr/share/omarchy/config/omarchy/shell.json"
if [ ! -e "$live" ] || { [ -f "$stock" ] && cmp -s "$live" "$stock"; }; then
  "$DOTFILES_DIR/install-scripts/sync-shell-json" --push
fi
