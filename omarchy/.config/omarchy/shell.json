{
  "bar": {
    "background": "opaque",
    "id": "romanhan.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators",
          "source": "~/.config/omarchy/plugins/romanhan.bar/widgets/Indicators.qml",
          "type": "qml"
        },
        {
          "id": "omarchy.elsewhen",
          "zones": "Tallinn|Europe/Tallinn, New York|America/New_York"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "romanhan.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "romanhan.media"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "left": [
        {
          "id": "omarchy.workspaces",
          "source": "~/.config/omarchy/plugins/romanhan.bar/widgets/Workspaces.qml",
          "type": "qml"
        }
      ],
      "right": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "hidden": [],
          "id": "romanhan.tray",
          "pinned": []
        },
        {
          "id": "romanhan.tailscale"
        },
        {
          "id": "romanhan.agents"
        },
        {
          "id": "romanhan.bluetooth"
        },
        {
          "id": "romanhan.network"
        },
        {
          "id": "romanhan.audio"
        },
        {
          "id": "romanhan.monitor"
        },
        {
          "id": "romanhan.power",
          "showPercentage": false
        },
        {
          "id": "island-reveal",
          "type": "qml"
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "romanhan.media"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1,
  "disabledPlugins": [
    "omarchy.media"
  ]
}
