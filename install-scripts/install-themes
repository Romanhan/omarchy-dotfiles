#!/bin/sh
# Clone the upstream themes that are too large to keep in this repo.
#
# Clone into the live themes directory, not the repo. On a fresh machine
# ~/.config/omarchy/themes is a real directory, so install-dotfiles links each
# tracked theme individually instead of linking the whole directory; cloning
# into the repo would leave the new themes invisible to the shell.
# When the live directory is a symlink into the repo (a hand-stowed setup),
# this writes to the repo and .gitignore keeps it out of git.
set -eu

themes="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes"
mkdir -p "$themes"

failed=0

clone_theme() {
  name=$1
  url=$2

  if [ -d "$themes/$name" ]; then
    echo "$name already present, skipping"
    return 0
  fi

  echo "Cloning $name..."
  if ! git clone --depth 1 "$url" "$themes/$name"; then
    echo "Warning: could not clone $name; skipping." >&2
    rm -rf -- "$themes/$name"
    failed=1
  fi
}

clone_theme blackgold  https://github.com/HANCORE-linux/omarchy-blackgold-theme.git
clone_theme harbordark https://github.com/HANCORE-linux/omarchy-harbordark-theme.git
clone_theme dracula    https://github.com/catlee/omarchy-dracula-theme

exit "$failed"
