#!/bin/bash

set -euo pipefail

PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
OMARCHY_DIR=${OMARCHY_PATH:-/usr/share/omarchy}
STOCK_DIR="$OMARCHY_DIR/shell/plugins/bar"

if [[ ! -r "$STOCK_DIR/Bar.qml" || ! -r "$STOCK_DIR/BarModel.js" ]]; then
  echo "Cannot read the stock Omarchy bar in $STOCK_DIR" >&2
  exit 1
fi

if [[ ! -r "$PLUGIN_DIR/island.patch" ]]; then
  echo "Cannot read $PLUGIN_DIR/island.patch" >&2
  exit 1
fi

BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/romanhan-bar.XXXXXX")
trap 'rm -rf -- "$BUILD_DIR"' EXIT

cp -- "$STOCK_DIR/Bar.qml" "$BUILD_DIR/Bar.qml"
for patch_file in "$PLUGIN_DIR"/*.patch; do
  patch --batch --forward --silent -p1 -d "$BUILD_DIR" < "$patch_file"
done

bar_changed=false
model_changed=false
cmp -s "$BUILD_DIR/Bar.qml" "$PLUGIN_DIR/Bar.qml" || bar_changed=true
cmp -s "$STOCK_DIR/BarModel.js" "$PLUGIN_DIR/BarModel.js" || model_changed=true

if [[ "$bar_changed" == false && "$model_changed" == false ]]; then
  echo "romanhan.bar is already based on the current Omarchy bar"
  exit 0
fi

if [[ "$bar_changed" == true ]]; then
  install -m 0644 "$BUILD_DIR/Bar.qml" "$PLUGIN_DIR/Bar.qml"
fi
if [[ "$model_changed" == true ]]; then
  install -m 0644 "$STOCK_DIR/BarModel.js" "$PLUGIN_DIR/BarModel.js"
fi

echo "Rebuilt romanhan.bar from the current Omarchy bar"
